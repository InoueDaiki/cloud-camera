# 回線断試験用の kvssink(Producer SDK)のログ設定。再接続やバッファの破棄が分かるように INFO 以上を出す。
log4cplus.rootLogger=INFO, KvsConsoleAppender
log4cplus.appender.KvsConsoleAppender=log4cplus::ConsoleAppender
log4cplus.appender.KvsConsoleAppender.logToStdErr=true
log4cplus.appender.KvsConsoleAppender.layout=log4cplus::PatternLayout
log4cplus.appender.KvsConsoleAppender.layout.ConversionPattern=[kvs %D{%H:%M:%S.%q} %-5p] %m%n
